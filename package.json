{
  "name": "chess-coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e -w client",
    "setup:engine": "node scripts/setup-engine.mjs",
    "bench:engine": "npm run bench:engine -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
