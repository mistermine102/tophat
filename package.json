{
  "name": "chess-coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "core",
    "client"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "npm run dev -w client",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e -w client",
    "acceptance": "npm run acceptance -w client",
    "bench:engine": "npm run bench:engine -w core",
    "bench:browser": "tsx client/scripts/browser-profile.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
